#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1, rgba32f) uniform image2D accumImage;

layout(push_constant) uniform PC {
    vec4 camPos;    // .xyz = position,  .w = time (seconds)
    vec4 camDir;    // .xyz = forward,   .w = aspect ratio
    vec4 camUp;     // .xyz = up vector, .w = tan(fov/2)
    vec4 camRight;  // .xyz = right vec, .w = accumCount
};

// ============================================================
//  Constants
// ============================================================
#define MAX_BOUNCES    5
#define NUM_SPHERES    9
#define PI             3.14159265358979323846
#define EPS            0.0015

#define MAT_DIFFUSE    0
#define MAT_METALLIC   1
#define MAT_DIELECTRIC 2
#define MAT_MARBLE     3

// ============================================================
//  Random Number Generator (PCG Hash)
// ============================================================
uint rngState;

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand01() {
    rngState = pcgHash(rngState);
    return float(rngState) * (1.0 / 4294967296.0);
}

vec3 randInUnitSphere() {
    for (int i = 0; i < 16; i++) {
        vec3 p = vec3(rand01(), rand01(), rand01()) * 2.0 - 1.0;
        if (dot(p, p) < 1.0) return p;
    }
    return vec3(0.0, 1.0, 0.0);
}

vec3 randCosineHemisphere(vec3 n) {
    return normalize(n + randInUnitSphere());
}

// ============================================================
//  Material & Geometry
// ============================================================
struct Material {
    vec3  albedo;
    float metallic;
    vec3  emission;
    float roughness;
    int   type;
    float ior;
};

struct Sphere {
    vec3  center;
    float radius;
    Material mat;
};

struct Hit {
    float    t;
    vec3     p;
    vec3     n;
    Material mat;
};

// ============================================================
//  Scene Definition
// ============================================================
Sphere scene[NUM_SPHERES];

void buildScene() {
    // 0: Center large chrome mirror
    scene[0] = Sphere(vec3(0.0, 1.0, 0.0), 1.0,
        Material(vec3(0.96), 1.0, vec3(0.0), 0.0, MAT_METALLIC, 1.0));

    // 1: Red diffuse sphere (back left)
    scene[1] = Sphere(vec3(-2.6, 0.7, -0.8), 0.7,
        Material(vec3(0.92, 0.12, 0.12), 0.0, vec3(0.0), 0.85, MAT_DIFFUSE, 1.0));

    // 2: Blue polished metallic sphere (back right)
    scene[2] = Sphere(vec3(2.5, 0.8, -0.5), 0.8,
        Material(vec3(0.12, 0.35, 0.95), 0.9, vec3(0.0), 0.06, MAT_METALLIC, 1.0));

    // 3: Green diffuse sphere (mid right)
    scene[3] = Sphere(vec3(1.1, 0.5, 1.8), 0.5,
        Material(vec3(0.12, 0.82, 0.22), 0.0, vec3(0.0), 0.85, MAT_DIFFUSE, 1.0));

    // 4: Clear refractive glass / crystal sphere (replaces the floating white ball!)
    scene[4] = Sphere(vec3(-1.1, 0.65, 1.9), 0.65,
        Material(vec3(0.98, 1.0, 0.98), 0.0, vec3(0.0), 0.0, MAT_DIELECTRIC, 1.52));

    // 5: Polished gold sphere
    scene[5] = Sphere(vec3(-1.6, 0.42, 0.6), 0.42,
        Material(vec3(0.98, 0.78, 0.25), 1.0, vec3(0.0), 0.12, MAT_METALLIC, 1.0));

    // 6: Purple polished sphere (front)
    scene[6] = Sphere(vec3(0.0, 0.62, 3.2), 0.62,
        Material(vec3(0.65, 0.12, 0.85), 0.25, vec3(0.0), 0.08, MAT_METALLIC, 1.0));

    // 7: Cyan mirror sphere (front right)
    scene[7] = Sphere(vec3(3.3, 0.6, 1.7), 0.6,
        Material(vec3(0.65, 0.96, 0.96), 0.96, vec3(0.0), 0.02, MAT_METALLIC, 1.0));

    // 8: Polished procedural marble sphere (replaces the second floating white ball!)
    scene[8] = Sphere(vec3(-3.2, 0.55, 1.2), 0.55,
        Material(vec3(0.85), 0.05, vec3(0.0), 0.15, MAT_MARBLE, 1.0));
}

// ============================================================
//  Intersections
// ============================================================
bool hitSphere(vec3 ro, vec3 rd, Sphere s, inout Hit h) {
    vec3  oc = ro - s.center;
    float a  = dot(rd, rd);
    float hb = dot(oc, rd);
    float c  = dot(oc, oc) - s.radius * s.radius;
    float disc = hb * hb - a * c;
    if (disc < 0.0) return false;

    float sqrtD = sqrt(disc);
    float t = (-hb - sqrtD) / a;
    if (t < EPS || t > h.t) {
        t = (-hb + sqrtD) / a;
        if (t < EPS || t > h.t) return false;
    }

    h.t = t;
    h.p = ro + rd * t;
    h.n = (h.p - s.center) / s.radius;
    h.mat = s.mat;

    // Apply procedural texture for marble sphere
    if (s.mat.type == MAT_MARBLE) {
        vec3 lp = (h.p - s.center) * 4.0;
        float s0 = sin(lp.x * 3.0 + sin(lp.y * 4.0 + sin(lp.z * 3.5) * 2.0) * 2.5);
        float s1 = cos(lp.y * 5.0 + lp.x * 2.0);
        float marble = clamp(0.5 + 0.5 * (s0 * 0.7 + s1 * 0.3), 0.0, 1.0);
        vec3 deepJade = vec3(0.05, 0.28, 0.16);
        vec3 paleVein = vec3(0.92, 0.96, 0.91);
        h.mat.albedo = mix(deepJade, paleVein, marble);
    }

    return true;
}

bool hitPlane(vec3 ro, vec3 rd, inout Hit h) {
    if (abs(rd.y) < 1e-5) return false;
    float t = -ro.y / rd.y;
    if (t < EPS || t > h.t) return false;

    h.t = t;
    h.p = ro + rd * t;
    h.n = vec3(0.0, 1.0, 0.0);

    // Anti-aliased checkerboard floor (eliminates distant sparkling noise)
    vec2 p = h.p.xz * 0.5;
    float filterWidth = clamp(t * 0.003, 0.001, 0.45);
    vec2 c = floor(p);
    vec2 f = clamp((fract(p) - 0.5) / filterWidth + 0.5, 0.0, 1.0);
    float check = mix(f.x, 1.0 - f.x, f.y);
    float baseTile = mod(c.x + c.y, 2.0);
    float tileVal = mix(baseTile, 1.0 - baseTile, check);

    // Fade into smooth 50% neutral tone at the horizon
    float distFade = clamp((t - 30.0) / 40.0, 0.0, 1.0);
    tileVal = mix(tileVal, 0.5, distFade);

    h.mat.albedo    = mix(vec3(0.14), vec3(0.88), tileVal);
    h.mat.metallic  = 0.06;
    h.mat.emission  = vec3(0.0);
    h.mat.roughness = 0.35;
    h.mat.type      = MAT_DIFFUSE;
    h.mat.ior       = 1.0;
    return true;
}

bool traceScene(vec3 ro, vec3 rd, inout Hit h) {
    h.t = 1e30;
    bool hit = false;
    for (int i = 0; i < NUM_SPHERES; i++) {
        if (hitSphere(ro, rd, scene[i], h)) hit = true;
    }
    if (hitPlane(ro, rd, h)) hit = true;
    return hit;
}

// Shadow ray for direct sun lighting
bool isInShadow(vec3 ro, vec3 rd, float maxDist) {
    Hit sh;
    sh.t = maxDist;
    for (int i = 0; i < NUM_SPHERES; i++) {
        // Glass lets light through (caustics approximation)
        if (scene[i].mat.type == MAT_DIELECTRIC) continue;
        if (hitSphere(ro, rd, scene[i], sh)) return true;
    }
    return false;
}

// ============================================================
//  Lighting & Sky
// ============================================================
const vec3 SUN_DIR   = normalize(vec3(0.5, 0.45, -0.6));
const vec3 SUN_COLOR = vec3(3.2, 2.9, 2.4);

vec3 skyColor(vec3 rd) {
    float t = clamp(0.5 * (rd.y + 1.0), 0.0, 1.0);
    vec3 sky = mix(vec3(0.72, 0.65, 0.58),   // warm horizon
                   vec3(0.20, 0.45, 0.88),   // clear atmosphere blue
                   t);

    // Sharp sun disc & soft halo in the sky
    float sd = max(dot(rd, SUN_DIR), 0.0);
    sky += vec3(1.0, 0.95, 0.8) * pow(sd, 1024.0) * 16.0;
    sky += vec3(1.0, 0.80, 0.5) * pow(sd, 24.0)   * 0.8;
    return sky;
}

vec3 ambientLight(vec3 n, vec3 albedo) {
    float up = n.y * 0.5 + 0.5;
    vec3 skyAmb = mix(vec3(0.24, 0.22, 0.20), vec3(0.18, 0.32, 0.55), up);
    return albedo * skyAmb;
}

vec3 directSunLight(vec3 p, vec3 n, vec3 albedo) {
    // Soft sun penumbra jitter
    vec3 lightDir = normalize(SUN_DIR + randInUnitSphere() * 0.035);
    float nDotL = dot(n, lightDir);
    if (nDotL <= 0.0) return vec3(0.0);

    vec3 sro = p + n * (EPS * 2.0);
    if (isInShadow(sro, lightDir, 1e20)) {
        return vec3(0.0);
    }
    return albedo * SUN_COLOR * nDotL;
}

// ============================================================
//  Path Tracer
// ============================================================
vec3 tracePath(vec3 ro, vec3 rd) {
    vec3 throughput = vec3(1.0);
    vec3 color      = vec3(0.0);

    for (int bounce = 0; bounce <= MAX_BOUNCES; bounce++) {
        Hit h;
        if (!traceScene(ro, rd, h)) {
            color += throughput * skyColor(rd);
            break;
        }

        // Direct illumination (Next Event Estimation) on diffuse/marble surfaces
        if (h.mat.type == MAT_DIFFUSE || h.mat.type == MAT_MARBLE) {
            color += throughput * (ambientLight(h.n, h.mat.albedo) + directSunLight(h.p, h.n, h.mat.albedo));
        }

        // Glass / Dielectric (Refraction + Fresnel Reflection)
        if (h.mat.type == MAT_DIELECTRIC) {
            bool frontFace = dot(rd, h.n) < 0.0;
            vec3 n = frontFace ? h.n : -h.n;
            float eta = frontFace ? (1.0 / h.mat.ior) : h.mat.ior;

            float cosTheta = min(dot(-rd, n), 1.0);
            float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
            bool cannotRefract = (eta * sinTheta) > 1.0;

            // Schlick Fresnel approximation
            float r0 = (1.0 - eta) / (1.0 + eta);
            r0 = r0 * r0;
            float reflectance = r0 + (1.0 - r0) * pow(1.0 - cosTheta, 5.0);

            vec3 scatterDir;
            if (cannotRefract || reflectance > rand01()) {
                scatterDir = reflect(rd, n);
            } else {
                scatterDir = refract(rd, n, eta);
            }

            rd = normalize(scatterDir);
            ro = h.p + rd * (EPS * 2.0);
            throughput *= h.mat.albedo;
            continue;
        }

        // Metallic reflection
        if (h.mat.type == MAT_METALLIC || (rand01() < h.mat.metallic)) {
            vec3 refl = reflect(rd, h.n);
            rd = normalize(refl + h.mat.roughness * randInUnitSphere());
            if (dot(rd, h.n) <= 0.0) break;
            ro = h.p + h.n * EPS;
            throughput *= h.mat.albedo;
        } else {
            // Cosine-weighted diffuse bounce
            rd = randCosineHemisphere(h.n);
            ro = h.p + h.n * EPS;
            throughput *= h.mat.albedo * 0.45; // Indirect bounce contribution
        }

        // Russian Roulette path termination after bounce 2
        if (bounce > 1) {
            float p = max(max(throughput.x, throughput.y), throughput.z);
            if (rand01() > p) break;
            throughput /= p;
        }
    }
    return color;
}

// ============================================================
//  Main Compute Dispatch
// ============================================================
void main() {
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (px.x >= size.x || px.y >= size.y) return;

    uint accumCount = uint(round(camRight.w));

    // Seed RNG per pixel and per accumulation frame
    uint seed = uint(px.x) + uint(px.y) * uint(size.x) + accumCount * 1973u + 928371u;
    rngState = pcgHash(seed);

    buildScene();

    float aspect     = camDir.w;
    float tanHalfFov = camUp.w;

    // 4 samples per pixel this frame
    const int SPP = 4;
    vec3 frameColor = vec3(0.0);

    for (int s = 0; s < SPP; s++) {
        vec2 jitter = vec2(rand01(), rand01()) - 0.5;
        vec2 uv = (vec2(px) + 0.5 + jitter) / vec2(size);
        uv = uv * 2.0 - 1.0;
        uv.y = -uv.y;

        vec3 rd = normalize(camDir.xyz
                            + uv.x * aspect * tanHalfFov * camRight.xyz
                            + uv.y * tanHalfFov * camUp.xyz);

        frameColor += tracePath(camPos.xyz, rd);
    }
    frameColor /= float(SPP);

    // Temporal accumulation
    vec3 accumulated;
    if (accumCount == 0) {
        accumulated = frameColor;
        imageStore(accumImage, px, vec4(frameColor, 1.0));
    } else {
        vec3 prev = imageLoad(accumImage, px).rgb;
        float weight = 1.0 / float(accumCount + 1);
        accumulated = mix(prev, frameColor, weight);
        imageStore(accumImage, px, vec4(accumulated, 1.0));
    }

    // ACES tonemapping
    vec3 col = accumulated / (accumulated + vec3(1.0));

    // Gamma correction
    col = pow(col, vec3(1.0 / 2.2));

    imageStore(outputImage, px, vec4(col, 1.0));
}
